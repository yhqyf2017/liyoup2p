# 励联 P2P 平台凭据配置（复制为 .env 后填写；.env 含敏感信息，切勿提交仓库或外发）
# 所有项均为必填，缺失时平台拒绝启动。

# PostgreSQL 连接串（服务器需已安装并启动 PostgreSQL）
# 示例：postgres://liyou:你的数据库密码@127.0.0.1:5432/liyou?sslmode=disable
LIYOU_DSN=

# JWT 签名密钥（随机长字符串，泄露等于全平台账号可伪造；建议 64 位以上）
LIYOU_JWT_SECRET=

# 种子账号 admin 的密码（控制台普通管理员）
LIYOU_ADMIN_PASSWORD=

# 种子账号 superadmin 的密码（控制台超级管理员）
LIYOU_SUPERADMIN_PASSWORD=

# 可选：HTTP 监听地址（默认 :8900）
# LIYOU_HTTP_ADDR=:8900

# 可选：TCP 中继监听地址（默认 :8901）
# LIYOU_RELAY_ADDR=:8901
